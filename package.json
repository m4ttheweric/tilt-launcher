{
  "name": "tilt-launcher",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:electron": "bun run --filter @tilt-launcher/shell-electron dev",
    "dev:web": "bun run --filter @tilt-launcher/ui dev",
    "dev:tauri": "bun run --filter @tilt-launcher/ui dev & bun run --filter @tilt-launcher/shell-tauri dev",
    "build": "bun run check && bun run lint && bun run --filter @tilt-launcher/shell-electron build",
    "preview": "cd packages/shell-electron && electron-vite preview",
    "check": "tsgo --noEmit -p packages/sdk/tsconfig.json && tsgo --noEmit -p packages/ui/tsconfig.json && tsgo --noEmit -p packages/shell-electron/tsconfig.json",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:sdk": "bun test tests/sdk.e2e.test.ts --timeout 120000",
    "package:app": "bun package-app.ts",
    "package:dmg": "./package-dmg.sh",
    "install:app": "bun install.ts",
    "release": "bun release.ts",
    "release:dry": "bun release.ts --dry-run",
    "prepare": "echo '#!/bin/bash\\nexec \"$(git rev-parse --show-toplevel)/hooks/pre-commit\"' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260226.1",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1"
  }
}
