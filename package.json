{
  "name": "tilt-launcher",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:electron": "bun run --filter @tilt-launcher/shell-electron dev",
    "dev:web": "bun run --filter @tilt-launcher/ui dev",
    "dev:tauri": "bun run --filter @tilt-launcher/shell-tauri dev",
    "build": "bun run check && bun run lint && bun run --filter @tilt-launcher/shell-electron build",
    "preview": "cd packages/shell-electron && electron-vite preview",
    "check": "tsgo --noEmit -p packages/sdk/tsconfig.json && tsgo --noEmit -p packages/ui/tsconfig.json && tsgo --noEmit -p packages/shell-electron/tsconfig.json && tsc --noEmit -p packages/sidecar/tsconfig.json",
    "lint": "eslint packages/ && eslint --config packages/ui/eslint.config.js packages/ui/",
    "lint:fix": "eslint packages/ --fix && eslint --config packages/ui/eslint.config.js packages/ui/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:sdk": "bun test tests/sdk.e2e.test.ts --timeout 120000",
    "test:sidecar": "bun run build:sidecar && bun test tests/sidecar.e2e.test.ts --timeout 120000",
    "test:client": "bun test tests/tiltClient.e2e.test.ts --timeout 120000",
    "build:sdk": "bun run --filter @tilt-launcher/sdk build",
    "build:sidecar": "bun run --filter @tilt-launcher/sidecar build",
    "build:packages": "bun run build:sdk && bun run build:sidecar",
    "check:packages": "bun run --filter @tilt-launcher/sdk check && bun run --filter @tilt-launcher/sidecar check",
    "publish:patch": "bun publish-packages.ts patch",
    "publish:minor": "bun publish-packages.ts minor",
    "publish:major": "bun publish-packages.ts major",
    "publish:dry": "bun publish-packages.ts --dry-run",
    "package:app": "bun package-app.ts",
    "package:dmg": "./package-dmg.sh",
    "install:app": "bun install.ts",
    "release": "bun release.ts",
    "release:dry": "bun release.ts --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260226.1",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1"
  }
}
