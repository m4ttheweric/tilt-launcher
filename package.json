{
  "name": "tilt-launcher",
  "version": "1.2.0",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "bun run check && bun run lint && electron-vite build",
    "preview": "electron-vite preview",
    "check": "tsgo --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:sdk": "bun test tests/sdk.e2e.test.ts --timeout 120000",
    "package:app": "bun package-app.ts",
    "package:dmg": "./package-dmg.sh",
    "install:app": "bun install.ts",
    "release": "bun release.ts",
    "release:dry": "bun release.ts --dry-run",
    "prepare": "echo '#!/bin/bash\nexec \"$(git rev-parse --show-toplevel)/hooks/pre-commit\"' > .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit || true"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/packager": "^19.0.5",
    "@eslint/js": "^10.0.1",
    "@internationalized/date": "^3.11.0",
    "@lucide/svelte": "^0.561.0",
    "@tanstack/table-core": "^8.21.3",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260226.1",
    "bits-ui": "^2.16.2",
    "clsx": "^2.1.1",
    "electron": "^40.6.1",
    "electron-vite": "^5.0.0",
    "embla-carousel-svelte": "^8.6.0",
    "eslint": "^10.0.2",
    "eslint-plugin-svelte": "^3.15.0",
    "formsnap": "^2.0.1",
    "globals": "^17.3.0",
    "layerchart": "2.0.0-next.43",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte-sonner": "^1.0.7",
    "sveltekit-superforms": "^2.28.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript-eslint": "^8.56.1",
    "vaul-svelte": "^1.0.0-next.7"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "ansi_up": "^6.0.6",
    "svelte": "^5.53.5",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1"
  }
}
