{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tilt Launcher",
  "version": "1.2.0",
  "identifier": "com.tiltlauncher.tauri",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5210",
    "beforeDevCommand": "cd ../ui && npx vite --port 5210 --strict-port",
    "beforeBuildCommand": "cd ../ui && npx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Tilt Launcher",
        "width": 1560,
        "height": 980,
        "minWidth": 1200,
        "minHeight": 760,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
